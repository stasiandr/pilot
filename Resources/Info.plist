<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>                 <string>Pilot</string>
    <key>CFBundleDisplayName</key>          <string>Pilot</string>
    <key>CFBundleIdentifier</key>           <string>dev.local.pilot</string>
    <key>CFBundleExecutable</key>           <string>Pilot</string>
    <key>CFBundleIconFile</key>             <string>Pilot</string>
    <key>CFBundleIconName</key>             <string>Pilot</string>
    <key>CFBundlePackageType</key>          <string>APPL</string>
    <key>CFBundleShortVersionString</key>   <string>0.1.0</string>
    <key>CFBundleVersion</key>              <string>1</string>
    <key>LSMinimumSystemVersion</key>       <string>14.0</string>
    <key>NSPrincipalClass</key>             <string>NSApplication</string>
    <key>NSHighResolutionCapable</key>      <true/>
    <key>LSApplicationCategoryType</key>    <string>public.app-category.developer-tools</string>
    <key>NSSupportsAutomaticTermination</key> <true/>
    <!-- Языки интерфейса. Строки Pilot переводит сам (Localization/), а этот
         список нужен штатным частям macOS — меню «Правка», «Окно», панели
         поиска: без него AppKit не узнает, что Pilot говорит по-русски.
         Язык по умолчанию — английский, как и у самого Pilot, когда
         ни один из языков системы ему не знаком. -->
    <key>CFBundleDevelopmentRegion</key>    <string>en</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>ru</string>
        <string>en</string>
    </array>
    <!-- pilot://open?file=…&line=…&project=… — так второй процесс передаёт
         файл уже запущенному Pilot (LaunchForwarding). -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>      <string>dev.local.pilot.open</string>
            <key>CFBundleURLSchemes</key>   <array><string>pilot</string></array>
        </dict>
    </array>
</dict>
</plist>
