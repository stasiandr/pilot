#!/bin/bash
# Окно git без окна — вкладка в PNG:
#
#   bin/pilot-git Репозиторий [--tab commit|history|stash|journal|changes|popover|merge]
#                 [--path файл] [--select хэш] [--width 1100] [--height 700] [--out git.png]
#                 [--mode mine|mainline|graph] [--expand first|хэш]
#                 [--lang en] [--wait 4] [--click x,y]… [--dump]
#
# Окно не показывается, приложение не активируется. git только читается,
# пока щелчки не жмут кнопки, которые его меняют. Подробно —
# Sources/Pilot/Git/HeadlessGit.swift.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BIN="$ROOT/Pilot.app/Contents/MacOS/Pilot"
DEBUG="$(cd "$ROOT" && swift build -c debug --show-bin-path 2>/dev/null)/Pilot"
# Свежее из двух: debug-сборка обычно новее бандла.
if [[ -x "$DEBUG" && ( ! -x "$BIN" || "$DEBUG" -nt "$BIN" ) ]]; then BIN="$DEBUG"; fi
if [[ ! -x "$BIN" ]]; then
    echo "Pilot не собран: ./build.sh debug" >&2
    exit 2
fi
TARGET="$1"; shift
# Строки NSLog (с датой) — шум для терминала; свои сообщения идут как "pilot: …".
exec "$BIN" --render-git "$TARGET" "$@" 2> >(grep -v '^[0-9]\{4\}-' >&2)
