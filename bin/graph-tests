#!/bin/bash
# Эталонные цепочки графа значения. Строка —
#   Файл.cs:строка:столбец | Значение <- Код <- Источник | ещё цепочка…
# Часть, которая начинается с `--`, — флаги графа: `| --assets |`.
# Случаи, файлов которых на этой машине нет, пропускаются. Эталоны проекта
# удобно держать рядом с его расширением: .pilot/extensions/<имя>/graph-tests.txt.
#
#   bin/graph-tests                        GraphTests/*.txt
#   bin/graph-tests путь/graph-tests.txt…  эти файлы
#   bin/graph-tests -v …                   с деревом каждого графа
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
VERBOSE=0; [[ "${1:-}" == "-v" ]] && { VERBOSE=1; shift; }
FILES=("$@")
if [[ ${#FILES[@]} == 0 ]]; then
    shopt -s nullglob
    FILES=("$ROOT"/GraphTests/*.txt)
fi
# Без xargs: он разбирает кавычки, а в цепочке бывает литерал `""`.
trim() { local s="$1"; s="${s#"${s%%[![:space:]]*}"}"; printf '%s' "${s%"${s##*[![:space:]]}"}"; }
passed=0; failed=0; skipped=0
while IFS= read -r line; do
    [[ -z "${line// }" || "$line" == \#* ]] && continue
    IFS='|' read -ra parts <<< "$line"
    target="$(trim "${parts[0]}")"
    file="${target%:*:*}"
    if [[ ! -f "$file" ]]; then skipped=$((skipped + 1)); continue; fi
    args=()
    expected=0
    for expect in "${parts[@]:1}"; do
        expect="$(trim "$expect")"
        if [[ "$expect" == --* ]]; then
            read -ra flags <<< "$expect"
            args+=("${flags[@]}")
        else
            args+=(--expect "$expect")
            expected=$((expected + 1))
        fi
    done
    output="$("$ROOT/bin/pilot-graph" "$target" "${args[@]}" 2>/dev/null)"; code=$?
    echo "── $(basename "$file"):${target#"$file":}"
    if [[ $VERBOSE == 1 ]]; then echo "$output"; else echo "$output" | grep -E '^(✓|✗) '; fi
    # Прошёл — если каждая цепочка отметилась ✓. Код 0 с пустым выводом
    # значит, что граф не строился вовсе (Pilot отдал запрос открытому окну).
    confirmed=$(echo "$output" | grep -c '^✓ ')
    if [[ $code == 0 && -n "$output" ]] && (( confirmed == expected )); then
        passed=$((passed + 1))
    else
        [[ $code == 0 ]] && echo "✗ граф не построился: $(echo "$output" | head -1)"
        failed=$((failed + 1))
    fi
done < <(cat /dev/null "${FILES[@]}")
echo
echo "графов: прошло $passed, упало $failed, пропущено $skipped"
[[ $failed == 0 ]]
