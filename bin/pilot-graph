#!/bin/bash
# Граф значения без окна — тот же движок, что у ⌥⌘G:
#
#   bin/pilot-graph Файл.cs:строка:столбец [--depth 6] [--limit 60] [--no-calls] [--arguments]
#                   [--assets] [--fan-in N] [--json] [--lang en] [--expect "Значение <- Код <- Источник"]…
#   bin/pilot-graph Файл.cs:строка:столбец --definition
#   bin/pilot-graph Папка/ [--depth 6] [--limit 60] [--calls] [-v]
#
# В позиции — любое значение: поле, свойство, переменная, параметр, метод,
# значение перечисления, компонент. Печатает граф деревом от значения к
# источникам (← данные, ⇠ сеть, ? условие) и строку «источники:» —
# литералы, константы, конфиги, инспектор, время, случайное… `--expect` —
# цепочка названий узлов (подстроки); код выхода 1, если какой-то нет.
# `--no-calls` — не раскрывать самому вызовы и параметры, `--arguments` —
# раскрывать и то, что стоит только аргументом вызова, `--assets` — искать
# значения полей инспектора в префабах и сценах, `--definition` — только
# что компилятор знает об имени. С папкой — обзор: граф каждого поля и
# свойства и где он теряет след (вызовы — только с `--calls`). Проект и его
# пара должны хоть раз открываться в Pilot: компиляция и индекс берутся из кэша.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BIN="$ROOT/Pilot.app/Contents/MacOS/Pilot"
DEBUG="$(cd "$ROOT" && swift build -c debug --show-bin-path 2>/dev/null)/Pilot"
# Свежее из двух: debug-сборка обычно новее бандла.
if [[ -x "$DEBUG" && ( ! -x "$BIN" || "$DEBUG" -nt "$BIN" ) ]]; then BIN="$DEBUG"; fi
if [[ ! -x "$BIN" ]]; then
    echo "Pilot не собран: ./build.sh debug" >&2
    exit 2
fi
TARGET="$1"; shift
# Строки NSLog (с датой) — шум для терминала; сообщения самого графа идут как "pilot: …".
# Встроенные расширения — из репозитория: debug-бинарник живёт не в бандле.
[[ -d "$ROOT/Extensions" ]] && export PILOT_EXTENSIONS="$ROOT/Extensions"
exec "$BIN" --value-graph "$TARGET" "$@" 2> >(grep -v '^[0-9]\{4\}-' >&2)
