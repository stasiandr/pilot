{
  "name": "OneState",
  "description": "Соглашения clm-client и clm-server",
  "match": {
    "remotes": ["gitlab.chillgaming.org:clm-project/", "gitlab.chillgaming.org/clm-project/"]
  },
  "pair": {
    "mirrors": ["docs/conventions/", ".claude/skills/"]
  },
  "datagrams": {
    "interface": "INetworkDatagram",
    "write": ["Write", "Serialize"],
    "read": ["Read", "Deserialize"],
    "send": ["Send"],
    "receive": ["NetworkFilter"]
  },
  "configs": {
    "folder": "Configs",
    "registry": "meta.json",
    "folderConfig": "folder.json",
    "generated": "Generated",
    "aliases": "ConfigAliases",
    "modelAttribute": "JsonType",
    "keyAttribute": "JsonProperty"
  },
  "nuget": {
    "sources": [
      { "name": "clm-project", "url": "https://gitlab.chillgaming.org/api/v4/projects/155/packages/nuget/index.json" }
    ]
  }
}
